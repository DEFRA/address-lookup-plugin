{
  "name": "@defra/address-lookup-plugin",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "files": [
    ".server",
    ".public",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./.server/plugins/postcode-lookup/index.js",
      "default": "./.server/plugins/postcode-lookup/index.js"
    },
    "./types": {
      "types": "./.server/plugins/postcode-lookup/types/index.d.ts",
      "import": "./.server/plugins/postcode-lookup/types/index.js",
      "default": "./.server/plugins/postcode-lookup/types/index.js"
    },
    "./routes": "./.server/plugins/postcode-lookup/routes/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf ./.server ./.src && npm run build:scss && npm run build:server && npm run build:types && npm run build:src",
    "build:server": "babel --delete-dir-on-start --extensions \".js\",\".ts\" --ignore \"**/*.test.ts\" --copy-files --no-copy-ignored --source-maps --out-dir ./.server ./src",
    "build:scss": "npx sass --style=expanded application.scss public/build/stylesheets/application.css",
    "build:src": "node scripts/resolve-tilde-imports.js",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.alias.json",
    "dev": "concurrently \"npm run server:watch:dev\" --kill-others --names \"client,server\" --prefix-colors \"red.dim,blue.dim\"",
    "start": "node index.js",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --cache --cache-location .cache/prettier --cache-strategy content --check \"**/*.{cjs,js,json,md,mjs,scss,ts}\"",
    "lint": "npm run lint:js && npm run lint:types",
    "lint:editorconfig": "editorconfig-checker",
    "lint:js": "node --max-old-space-size=8192 ./node_modules/.bin/eslint --cache --cache-location .cache/eslint --cache-strategy content --color .",
    "lint:scss": "stylelint --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore --max-warnings 0 \"**/*.scss\"",
    "lint:types": "tsc --noEmit",
    "server:watch": "NODE_ENV=development tsx watch --clear-screen=false --enable-source-maps --exclude \"**/*.test.*\"",
    "server:watch:dev": "npm run server:watch -- ./src/index.js",
    "test": "jest --color --coverage --verbose",
    "test:watch": "jest --color --watch"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@defra/hapi-tracing": "^1.29.0",
    "@hapi/boom": "^10.0.1",
    "@hapi/hapi": "^21.4.4",
    "@hapi/inert": "^7.1.0",
    "@hapi/vision": "^7.0.3",
    "@hapi/wreck": "^18.1.0",
    "@hapi/yar": "^11.0.3",
    "convict": "^6.2.5",
    "dotenv": "^17.2.3",
    "govuk-frontend": "^5.13.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "nunjucks": "^3.2.4",
    "prettier": "^3.6.2",
    "resolve": "^1.22.11"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-syntax-import-attributes": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/convict": "^6.1.6",
    "@types/eslint": "^9.6.1",
    "@types/nunjucks": "^3.2.6",
    "@types/resolve": "^1.20.6",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-replace-import-extension": "^1.1.5",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "concurrently": "^9.2.1",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "jest-extended": "^7.0.0",
    "neostandard": "^0.12.2",
    "sass": "^1.103.1",
    "standard": "^14.3.3",
    "stylelint": "^16.25.0",
    "stylelint-config-gds": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "tsx": "^4.20.6"
  },
  "allowScripts": {
    "@defra/hapi-tracing@1.30.0": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild": true,
    "unrs-resolver": true,
    "fsevents": true
  }
}
